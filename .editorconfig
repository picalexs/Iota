root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# JS/TS/React (Prettier uses 2 spaces anyway, this keeps editors consistent)
[*.{js,jsx,ts,tsx,cjs,mjs}]
indent_size = 2

# JSON / configs
[*.{json,jsonc}]
indent_size = 2

# YAML (Docker Compose, CI, etc.)
[*.{yml,yaml}]
indent_size = 2

# Markdown (don’t trim trailing spaces because they can be meaningful)
[*.md]
trim_trailing_whitespace = false

# Python (Prettier won't touch it; editors should use 4 spaces)
[*.py]
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab
