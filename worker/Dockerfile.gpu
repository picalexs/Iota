# syntax=docker/dockerfile:1.7

# The GPU Aer wheel supplies the CUDA 11 user-space libraries. The NVIDIA
# Container Toolkit supplies the host driver at runtime.
FROM python:3.12-slim AS builder

ENV RUSTUP_HOME=/opt/rustup \
	CARGO_HOME=/opt/cargo \
	PATH=/opt/cargo/bin:${PATH} \
	PIP_DEFAULT_TIMEOUT=300 \
	PIP_DISABLE_PIP_VERSION_CHECK=1 \
	PIP_RETRIES=10

WORKDIR /build

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential \
		cmake \
		curl \
		gfortran \
		libopenblas-dev \
	&& rm -rf /var/lib/apt/lists/*

RUN curl -sSfL https://sh.rustup.rs -o /tmp/rustup-init.sh \
	&& sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain stable \
	&& rm -f /tmp/rustup-init.sh

COPY worker/requirements.lock .

# Aer's GPU wheel replaces the CPU wheel at the same public import path. Keep
# the application lock file unchanged and derive the GPU lock input in-image.
RUN sed 's/^qiskit-aer==0\.17\.2$/qiskit-aer-gpu-cu11==0.17.2/' \
		requirements.lock > requirements-gpu.lock

RUN --mount=type=cache,target=/root/.cache/pip \
	python -m pip wheel --wheel-dir /wheels -r requirements-gpu.lock

FROM python:3.12-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1 \
	PYTHONPATH=/app \
	PIP_DEFAULT_TIMEOUT=300 \
	PIP_DISABLE_PIP_VERSION_CHECK=1 \
	PIP_RETRIES=10 \
	LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cusolver/lib:/usr/local/lib/python3.12/site-packages/nvidia/cusparse/lib:/usr/local/lib/python3.12/site-packages/cuquantum/lib

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		libgfortran5 \
		libgomp1 \
		libopenblas0-pthread \
	&& rm -rf /var/lib/apt/lists/*

COPY worker/requirements.lock .
COPY --from=builder /build/requirements-gpu.lock .
COPY shared /app/shared
COPY --from=builder /wheels /wheels
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels -r requirements-gpu.lock \
	&& rm -rf /wheels

COPY worker/. /app/worker
COPY worker/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN groupadd --gid 10001 appuser \
	&& useradd --uid 10001 --gid appuser --home-dir /app --shell /usr/sbin/nologin appuser \
	&& mkdir -p /app/local-state \
	&& chmod +x /app/docker-entrypoint.sh \
	&& chown -R appuser:appuser /app

USER appuser

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["python", "-m", "worker.main"]
