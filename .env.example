################################################################################
# .env.example
#
# Example environment variables for loopback-only local development.
# Copy this file to `.env` for local development.
# Do not use these values for a network deployment.
# Keep real secrets out of source control. Use a secret manager in production.
################################################################################

########################################
# Application / runtime
########################################

# Short build / app version identifier
APP_VERSION=dev
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# This must stay true only for the loopback-only local workbench. The API refuses
# placeholder credentials when this value is false.
ALLOW_INSECURE_DEFAULTS=true
# Interactive API docs (/docs, /redoc, /openapi.json). Leave empty to follow
# ALLOW_INSECURE_DEFAULTS, or set true/false to decide explicitly.
DOCS_ENABLED=

########################################
# HTTP / frontend
########################################
# Host port published for the API container
API_PORT=18000
# Host port published for the frontend dev server
FRONTEND_PORT=5173
# Host interface for published development ports. Keep loopback-only.
HOST_BIND=127.0.0.1
# Frontend build/runtime: point the frontend to the API base URL
# e.g. http://localhost:8000 when the browser should call the API directly.
# Leave empty when the UI is served behind the built-in /api proxy.
VITE_API_URL=
# Additional hostnames allowed by the Vite dev server, comma-separated.
# Leave empty for localhost/127.0.0.1-only Host header validation.
VITE_ALLOWED_HOSTS=
# API Host header allowlist. Set the public deployment hostname in production.
TRUSTED_HOSTS=localhost,127.0.0.1
# Optional hostname used by the production Nginx server block.
NGINX_SERVER_NAME=_

########################################
# Database (Postgres)
########################################
# Preferred runtime connection URL. Leave empty to use the DB_* fallback below.
DATABASE_URL=
# Hostname of the Postgres server (compose service: `db`)
DB_HOST=db
DB_PORT=5432
DB_NAME=vqe
DB_USER=vqe
# Development-only password placeholder — replace in production
DB_PASSWORD=dev-password-not-secret

########################################
# Redis / RQ (task queue)
########################################
# Redis requires authentication. This password is the single source of truth:
# Compose passes it to redis-server --requirepass and derives the default
# REDIS_URL below from it. Replace it outside local development.
REDIS_PASSWORD=dev-redis-not-secret
# Redis connection used by RQ workers and the app. Leave empty to use the
# password-bearing default that Compose derives from REDIS_PASSWORD
# (redis://:${REDIS_PASSWORD}@redis:6379/0). Set it explicitly only when
# pointing at a Redis outside this Compose stack, and include the credential.
REDIS_URL=
# Host port published by the development Compose override, if needed
REDIS_PUBLISHED_PORT=6379
# Queue consumed by API and worker
QUEUE_NAME=quantum
# Quantum run timeout (seconds)
QUANTUM_JOB_TIMEOUT_SECONDS=14400

########################################
# Worker / queue
########################################
# IBM Runtime credentials are configured through the app's Settings page and
# stored as encrypted local profiles. Do not place IBM tokens or instances here.
LOCAL_CREDENTIALS_KEYS=
LOCAL_CREDENTIALS_KEY_FILE=
LOCAL_OPERATOR_TOKEN=
LOCAL_OPERATOR_TOKEN_FILE=
# Bound CPU-side numerical libraries on CPU and GPU workers.
QSS_CPU_THREAD_LIMIT=8

########################################
# Persistent Docker volumes
########################################
# These names isolate this stack from other local Compose projects.
# Change them only when you intentionally want a separate data set.
PGDATA_VOLUME_NAME=quantum_simulation_studio_pgdata
REDISDATA_VOLUME_NAME=quantum_simulation_studio_redisdata
CREDENTIALKEYS_VOLUME_NAME=quantum_simulation_studio_credentialkeys
OPERATORACCESS_VOLUME_NAME=quantum_simulation_studio_operatoraccess

########################################
# Optional local GPU stack
########################################
# Uncomment both lines on a host with a verified NVIDIA GPU. The `:` separator
# is used by Docker Compose on Linux and WSL.
# COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.gpu.yml
# COMPOSE_PROFILES=gpu
